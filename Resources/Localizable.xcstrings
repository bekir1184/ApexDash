    "webGuideIntro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every lap shows up on the site by itself: track map, speed, throttle, brake, steering, ERS, and a corner by corner comparison."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her turun tam telemetrisi sitede kendiliğinden belirir: pist haritası, hız, gaz, fren, direksiyon, ERS ve viraj viraj karşılaştırma."
          }
        }
      }
    },
    "webGuideNotPaired": {
