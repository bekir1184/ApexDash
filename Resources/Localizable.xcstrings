    "webGuideStep1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open this site on a computer or tablet. The page shows a code and a QR."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarında ya da tabletinde bu siteyi aç. Sayfa bir kod ve QR gösterir."
          }
        }
      }
    },
    "webGuideStep2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap SCAN QR below and point the phone at the QR code on the site."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıdaki QR OKUT'a bas ve telefonu sitedeki QR koduna tut."
          }
        }
      }
    },
    "webGuideStep3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The site hands you over to the analysis on your phone. Laps come straight from the phone; keep both on the same Wi-Fi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Site seni telefondaki analize geçirir. Turlar doğrudan telefondan gelir; ikisi aynı Wi-Fi'da olsun."
          }
        }
      }
    },
    "webGuideSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See and study your laps on the site"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Turlarını sitede gör ve incele"
          }
        }
      }
    },
