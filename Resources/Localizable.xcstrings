    "flashWarningBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The screen flashes rapidly at the shift point, and the phone's flash can be used too if you enable it. If you have photosensitive epilepsy, keep these warnings off."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vites zamanı geldiğinde ekran hızla yanıp söner ve ayarlardan açılırsa telefonun flaşı da kullanılır. Işığa duyarlı epilepsiniz varsa bu uyarıları kapalı tutun."
          }
        }
      }
    },
