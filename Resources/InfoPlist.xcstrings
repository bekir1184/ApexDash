  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera scans the QR code on apexdash.pro to pair the phone with your browser."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera, telefonu tarayıcınla eşleştirmek için apexdash.pro'daki QR kodunu okur."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apex Dash receives telemetry from your game and serves lap analysis to browsers on the same network."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apex Dash oyundan telemetri alır ve tur analizini aynı ağdaki tarayıcılara sunar."
          }
        }
      }
    },
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apex Dash"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apex Dash"
          }
        }
      }
    }
  }
}